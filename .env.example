# ============================================================
# AI-АГЕНТ — ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# Скопируйте файл: cp .env.example .env  и заполните значения.
# ============================================================

# --- Обязательные ---

# Токен бота от @BotFather (в Telegram: /newbot)
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Ваш Telegram ID (узнать: @userinfobot) — сюда летят уведомления о заявках
OWNER_TELEGRAM_ID=123456789

# Название бизнеса — используется в приветствии и ответах
BUSINESS_NAME=ПримерКомпани

# --- Опционально: база данных ---
# Без этой переменной проект работает на локальном JSON-файле (data/db.json).
# Для Supabase: создайте проект -> Project Settings -> Database -> Connection string (URI)
# DATABASE_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Опционально: LLM (OpenAI-совместимый API) ---
# Без ключа агент отвечает по правилам и базе знаний (полностью бесплатно).
# С ключом — свободные формулировки через LLM. Работает с OpenAI / OpenRouter /
# Ollama (http://localhost:11434/v1) / GLM и любым OpenAI-совместимым API.
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Дашборд владельца ---
DASHBOARD_PORT=3000
# Пароль на дашборд (Basic Auth). Если не задан — дашборд открыт (только для локальных тестов!)
# DASHBOARD_PASSWORD=supersecret
